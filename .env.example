# Public https origin serving the app (cloudflared/ngrok tunnel or production domain).
# Set it to emit the fc:miniapp embed tag and /.well-known/farcaster.json.
NEARCASTER_URL=

# Signed accountAssociation from https://farcaster.xyz/~/developers/mini-apps/manifest?domain=<domain>
FARCASTER_ASSOC_HEADER=
FARCASTER_ASSOC_PAYLOAD=
FARCASTER_ASSOC_SIGNATURE=

# Snapchain HTTP API node (default https://snap.farcaster.xyz:3381).
VITE_HUB_URL=
